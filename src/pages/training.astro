---
import Base from "../layouts/Base.astro";

const R2 = "https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev";

const videos = [
  {
    id: "dQw4w9WgXcQ",
    name: "田中 美智子 様",
    age: "50代女性",
    complaint: "慢性的な肩こり・首の痛み",
    quote: "長年悩んでいた肩こりが、数回の施術でみるみる改善しました。宗家の手技は他では体験できない深さがあります。",
  },
  {
    id: "dQw4w9WgXcQ",
    name: "山本 健太郎 様",
    age: "40代男性",
    complaint: "腰痛・坐骨神経痛",
    quote: "病院でも治らなかった腰痛が、泰山流指圧で劇的に楽になりました。週に一度通うのが今では楽しみです。",
  },
  {
    id: "dQw4w9WgXcQ",
    name: "佐々木 恵子 様",
    age: "60代女性",
    complaint: "膝の痛み・むくみ",
    quote: "足のむくみと膝痛で歩くのが辛かったのですが、施術後は体が軽くなり、よく眠れるようになりました。",
  },
  {
    id: "dQw4w9WgXcQ",
    name: "Robert Johnson 様",
    age: "30代男性",
    complaint: "スポーツによる筋肉疲労",
    quote: "武道の稽古後の疲労回復に通っています。Sensei Miller's technique is unlike anything I've experienced.",
  },
  {
    id: "dQw4w9WgXcQ",
    name: "中村 洋子 様",
    age: "70代女性",
    complaint: "頭痛・めまい",
    quote: "頭痛薬が手放せなかった生活が変わりました。経絡へのアプローチが効いているのか、頭がすっきりします。",
  },
  {
    id: "dQw4w9WgXcQ",
    name: "鈴木 誠一 様",
    age: "50代男性",
    complaint: "デスクワークによる疲労・眼精疲労",
    quote: "PC作業が多く常に体が張っていましたが、施術後は全身がほぐれ、仕事の集中力も上がった気がします。",
  },
];
---

<Base
  title="治療院お客様の声"
  description="泰山流指圧整体院のお客様の声。慢性痛・肩こり・腰痛など、施術を受けた方々の体験談を動画でご紹介します。"
>

  <!-- ヒーローセクション -->
  <section class="ts-hero">
    <img
      src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/shiatsu/SHIATSU_DO_02.webp"
      alt="泰山流指圧整体院"
      class="ts-hero-bg"
    />
    <div class="ts-hero-overlay"></div>
    <div class="ts-hero-content">
      <p class="ts-eyebrow">Taizan-ryu Shiatsu</p>
      <h1 class="ts-hero-title">
        <span class="ts-line-a">お客様の声</span>
        <span class="ts-line-b">Testimonials</span>
      </h1>
      <p class="ts-hero-sub">施術を受けた方々の体験談</p>
    </div>
    <div class="ts-hero-scroll"><span></span></div>
  </section>

  <!-- タイトル・リード文 -->
  <section class="ts-lead">
    <div class="ts-inner">
      <div class="ts-lead-content reveal">
        <h2>治療院お客様の声</h2>
        <p>
          泰山流指圧整体院で施術を受けたお客様からのご感想を動画でご紹介します。
          慢性的な痛みや不調でお悩みの方の参考になれば幸いです。
          個人の感想であり、効果を保証するものではありません。
        </p>
      </div>
    </div>
  </section>

  <!-- 動画ストリーミング一覧 -->
  <section class="ts-videos">
    <div class="ts-inner">

      {videos.map((v, i) => (
        <article class={`ts-card reveal ts-card--${i % 2 === 0 ? 'normal' : 'reverse'}`}>

          <div class="ts-card-video">
            <div class="ts-video-wrap">
              <iframe
                src={`https://www.youtube.com/embed/${v.id}`}
                title={`${v.name} — お客様の声`}
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
          </div>

          <div class="ts-card-body">
            <div class="ts-card-meta">
              <span class="ts-tag">{v.complaint}</span>
            </div>
            <blockquote class="ts-card-quote">
              <p>「{v.quote}」</p>
            </blockquote>
            <div class="ts-card-person">
              <p class="ts-card-name">{v.name}</p>
              <p class="ts-card-age">{v.age}</p>
            </div>
          </div>

        </article>
      ))}

    </div>
  </section>

</Base>

<style>
  /* ===== 共通 ===== */
  .ts-inner {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ===== ヒーロー ===== */
  .ts-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .ts-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .ts-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.35) 0%,
      rgba(30, 20, 10, 0.75) 100%
    );
  }

  .ts-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    padding: 0 20px;
  }

  .ts-eyebrow {
    font-size: 0.8rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 24px;
    opacity: 0;
    animation: tsFadeUp 0.8s ease 0.2s forwards;
  }

  .ts-hero-title {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 28px;
  }

  .ts-line-a {
    font-size: clamp(2.8rem, 7vw, 5.5rem);
    font-weight: 600;
    letter-spacing: 6px;
    opacity: 0;
    animation: tsFadeUp 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.4s forwards;
  }

  .ts-line-b {
    font-size: clamp(1.4rem, 3.5vw, 2.6rem);
    font-weight: 300;
    letter-spacing: 8px;
    color: rgba(255, 255, 255, 0.75);
    opacity: 0;
    animation: tsFadeUp 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.6s forwards;
  }

  .ts-hero-sub {
    font-size: 0.9rem;
    letter-spacing: 3px;
    color: rgba(255, 255, 255, 0.6);
    opacity: 0;
    animation: tsFadeUp 0.8s ease 0.9s forwards;
  }

  .ts-hero-scroll {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
  }

  .ts-hero-scroll span {
    display: block;
    width: 1px;
    height: 60px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.5), transparent);
    margin: 0 auto;
    animation: tsScrollLine 2s ease-in-out infinite;
  }

  @keyframes tsFadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @keyframes tsScrollLine {
    0%   { transform: scaleY(0); transform-origin: top; opacity: 1; }
    50%  { transform: scaleY(1); transform-origin: top; opacity: 1; }
    100% { transform: scaleY(1); transform-origin: top; opacity: 0; }
  }

  /* ===== リード文 ===== */
  .ts-lead {
    padding: 80px 0;
    background-color: var(--bg-color);
  }

  .ts-lead-content {
    text-align: center;
    max-width: 680px;
    margin: 0 auto;
  }

  .ts-lead-content h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    letter-spacing: 4px;
    margin-bottom: 28px;
  }

  .ts-lead-content p {
    font-size: 0.9rem;
    line-height: 2;
    color: var(--text-secondary);
  }

  /* ===== 動画一覧 ===== */
  .ts-videos {
    padding: 0 0 100px;
    background-color: var(--bg-color);
  }

  /* ===== カード（横並び） ===== */
  .ts-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    padding: 64px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .ts-card:last-child {
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  /* 偶数カードは動画を右に */
  .ts-card--reverse {
    direction: rtl;
  }

  .ts-card--reverse > * {
    direction: ltr;
  }

  /* 動画 */
  .ts-video-wrap {
    position: relative;
    width: 100%;
    padding-top: 56.25%;
    border-radius: 10px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.4);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
  }

  .ts-video-wrap iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* テキスト側 */
  .ts-card-meta {
    margin-bottom: 20px;
  }

  .ts-tag {
    display: inline-block;
    font-size: 0.72rem;
    letter-spacing: 1.5px;
    padding: 4px 12px;
    border-radius: 20px;
    border: 1px solid rgba(107, 31, 35, 0.7);
    background-color: rgba(107, 31, 35, 0.25);
    color: #ffcccc;
  }

  .ts-card-quote {
    margin: 0 0 28px;
    padding: 0;
    border: none;
  }

  .ts-card-quote p {
    font-size: 1.05rem;
    line-height: 2;
    color: var(--text-primary);
    font-weight: 300;
    letter-spacing: 0.5px;
  }

  .ts-card-person {
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .ts-card-name {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 2px;
    margin-bottom: 4px;
  }

  .ts-card-age {
    font-size: 0.78rem;
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 900px) {
    .ts-inner { padding: 0 20px; }

    .ts-lead { padding: 60px 0; }

    .ts-videos { padding-bottom: 60px; }

    .ts-card {
      grid-template-columns: 1fr;
      gap: 32px;
      padding: 48px 0;
      direction: ltr;
    }

    .ts-card--reverse { direction: ltr; }

    .ts-line-a { letter-spacing: 4px; }
    .ts-line-b { letter-spacing: 5px; }
  }
</style>
