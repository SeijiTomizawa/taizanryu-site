<style>
  /* ===== 共通 ===== */
  .sd-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ===== ヒーロー ===== */
  .sd-hero {
    position: relative;
    width: 100%;
    height: 100vh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .sd-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .sd-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.4) 0%,
      rgba(107, 31, 35, 0.6) 100%
    );
  }

  .sd-hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    padding: 0 20px;
  }

  .sd-eyebrow {
    font-size: 0.85rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.7);
    margin-bottom: 24px;
    opacity: 0;
    animation: sdFadeUp 0.8s ease 0.2s forwards;
  }

  .sd-hero-title {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 28px;
  }

  .line-a {
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 600;
    letter-spacing: 6px;
    opacity: 0;
    animation: sdFadeUp 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) 0.4s forwards;
  }

  .line-b {
    font-size: clamp(2rem, 5vw, 3.8rem);
    font-weight: 300;
    letter-spacing: 8px;
