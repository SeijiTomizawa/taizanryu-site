---
import Base from "../layouts/Base.astro";
import images from "../components/blocks/images";

const dojos = [
  {
    id: "DOJO_01",
    name: "泰山流柔術 東海岸本部 コウジン道場",
    master: "エメリー・マルドロウ師範",
    location: "20 Seaview Avenue Jersey City N.J 07305, USA",
    discribe: "私たちは、そのビジョンに100％共感しています。それが「コウジン道場」のスタイルです。混沌としたこの世界において、真の修行とは帯やトロフィーのためではありません。それは、揺るぎない肉体、精神、そして魂の鎧を鍛え上げ、胸を張って歩み、脅威を早期に察知し、街が投げかけるあらゆる事態に対処できるようにすることです。言い訳は通用せず、経歴も問われません。ただ、純粋な可能性を解き放つだけです。",
    link: "製作中",
  },
  {
    id: "DOJO_02",
    name: "天庸流柔術 大阪総本部道場 木鶏塾",
    master: "垣本総師範",
    location: "大阪府大阪市北区天満",
    discribe: "力や身体の大きさに関係なく、一人ひとりのポテンシャルの向上を目的とした稽古を行ってります。",
    link: "https://mokkeijuku.com/", 
  },
  {
    id: "DOJO_03",
    name: "天庸流柔術　東京支部",
    master: "齊藤師範",
    location: "東京調布・三鷹・荻窪",
    discribe: "体操や指圧も行い、お互いに健康になれてしまうというお得な集まりですので、初心者の方もぜひ、気軽にご参加ください。",
    link: "https://9f0sw.hp.peraichi.com/",
  },
];
---

<Base
  title="友好関係の道場 | 泰山流護身術・逮捕術 東京八王子本部道場"
  description="世界各国から集まった仲間たちが、守破離の精神のもとで共に稽古に励んでいます。国籍・年齢・経験を超えた絆が、泰山流道場を一層豊かなものにしています。"
>

  <!-- タイトルセクション -->
  <section class="title">
    <div class="inner">
      <div class="title-content reveal">
        <p class="eyebrow">Taizan-ryu</p>
        <h1 class="title-text"><span class="ja">友好関係の道場</span><span class="en">Affiliated Dojos</span></h1>
        <p class="title-sub">Affiliated Dojos</p>
        <div class="divider"></div>
        <p class="title-desc ja">
          世界各国から集まった仲間たちが、守破離の精神のもとで共に稽古に励んでいます。
          国籍・年齢・経験を超えた絆が、泰山流道場を一層豊かなものにしています。
        </p>
        <p class="title-desc en">
          Students from around the world train together in the spirit of Shu-Ha-Ri.
          Bonds that transcend nationality, age, and experience make Taizan-ryu Dojo all the richer.
        </p>
      </div>
    </div>
  </section>

  <!-- ヒーローセクション -->
  <section class="hero">
    <img
      src={images.logoImage}
      alt="友好関係の道場"
      class="hero-bg"
    />
    <div class="hero-overlay"></div>
  </section>

  <!-- リストセクション -->
  <section class="list">
    <div class="inner">

      <div class="list-header reveal">
        <h2><span class="ja">友好関係の道場一覧</span><span class="en">Affiliated Dojos</span></h2>
        <p><span class="ja">友好関係の道場をご紹介します。</span><span class="en">Meet our affiliated dojos.</span></p>
      </div>

      <div class="grid">
        {dojos.map((dojo) => (
          <div class="card">
            <div class="card-photo">
              <img
                src={images.dojoInteriorImage}
                alt={dojo.name}
              />
            </div>
            <div class="card-body">
              <h3 class="card-name">{dojo.name}</h3>
              <p class="card-location">{dojo.location}</p>
              <p class="card-description">{dojo.discribe}</p>
              {dojo.link.startsWith('http') && (
                <a href={dojo.link} target="_blank" rel="noopener noreferrer" class="btn">
                  <span class="ja">ウェブページに行く</span><span class="en">Visit Page</span>
                </a>
              )}
            </div>
          </div>
        ))}

      </div>
    </div>
  </section>

</Base>

<style>
  /* ===== 共通 ===== */
  .inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ===== タイトルセクション ===== */
  .title {
    padding: calc(var(--header-height) + 80px) 0 80px;
    background-color: var(--bg-color);
    text-align: center;
  }

  .title-content {
    max-width: 640px;
    margin: 0 auto;
  }

  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .title-text {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 600;
    letter-spacing: 8px;
    line-height: 1;
    margin-bottom: 12px;
  }

  .title-sub {
    font-size: 0.85rem;
    letter-spacing: 5px;
    color: var(--text-secondary);
    margin-bottom: 40px;
  }

  .divider {
    width: 40px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.3);
    margin: 0 auto 40px;
  }

  .title-desc {
    font-size: 0.95rem;
    line-height: 2;
    color: var(--text-secondary);
  }

  /* ===== ヒーローセクション ===== */
  .hero {
    position: relative;
    width: 100%;
    height: 60vh;
    min-height: 360px;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(107, 31, 35, 0.3) 0%,
      rgba(0, 0, 0, 0.5) 100%
    );
  }

  /* ===== リストセクション ===== */
  .list {
    padding: 100px 0;
    background-color: var(--bg-color);
  }

  .list-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .list-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    letter-spacing: 4px;
    margin-bottom: 14px;
  }

  .list-header p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  /* カードリスト */
  .grid {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  /* カード（横並び） */
  .card {
    display: grid;
    grid-template-columns: 300px 1fr;
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    transition: box-shadow 0.4s ease, border-color 0.4s ease;
  }

  .card:hover {
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    border-color: rgba(255, 255, 255, 0.16);
  }

  /* カード写真 */
  .card-photo {
    min-height: 260px;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.3);
  }

  .card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease, filter 0.6s ease;
    filter: grayscale(20%);
  }

  .card:hover .card-photo img {
    transform: scale(1.04);
    filter: grayscale(0%);
  }

  /* カード本文 */
  .card-body {
    padding: 36px 40px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 12px;
  }

  .card-name {
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: 2px;
    line-height: 1.6;
  }

  .card-location {
    font-size: 0.82rem;
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  .card-description {
    font-size: 0.9rem;
    line-height: 2;
    color: var(--text-secondary);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    margin-top: 8px;
    padding: 10px 28px;
    background-color: #38bdf8;
    color: #0f172a;
    border-radius: 30px;
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.5px;
    transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }

  .btn:hover {
    background-color: #7dd3fc;
    transform: translateY(-3px);
    box-shadow: 0 10px 20px rgba(56, 189, 248, 0.3);
  }

  .btn-secondary {
    display: inline-block;
    align-self: flex-start;
    margin-top: 8px;
    padding: 10px 28px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: 24px;
    font-size: 0.82rem;
    letter-spacing: 1px;
    color: var(--text-primary);
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .btn-secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.5);
  }

  /* ===== CTA ===== */
  .cta {
    padding: 100px 0;
    background-color: #1a120d;
    text-align: center;
  }

  .cta h2 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    font-weight: 400;
    letter-spacing: 4px;
    margin-bottom: 20px;
  }

  .cta p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 40px;
    line-height: 1.8;
  }

  .btn-primary {
    display: inline-block;
    padding: 16px 48px;
    background-color: #fff;
    color: #1a120d;
    border-radius: 30px;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 1px;
    transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
  }

  .btn-primary:hover {
    background-color: var(--bg-color-secondary);
    transform: translateY(-3px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 900px) {
    .inner {
      padding: 0 20px;
    }

    .title {
      padding: calc(var(--header-height) + 48px) 0 60px;
    }

    .list,
    .cta {
      padding: 60px 0;
    }

    .card {
      grid-template-columns: 220px 1fr;
    }

    .card-body {
      padding: 24px;
    }
  }

  @media (max-width: 640px) {
    .card {
      grid-template-columns: 1fr;
    }

    .card-photo {
      min-height: 200px;
    }

    .hero {
      height: 45vh;
    }

    .grid {
      gap: 24px;
    }
  }
</style>
