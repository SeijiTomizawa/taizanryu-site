---
import Base from "../layouts/Base.astro";
import { getEmDashCollection } from "emdash";
import { getCloudflareStreamUrl } from "../components/blocks/videos";

const { entries: allVideos,    cacheHint: videosCacheHint }  = await getEmDashCollection("videos",       { limit: 100 });
const { entries: certificates, cacheHint: certsCacheHint }   = await getEmDashCollection("certificates", { status: "published", orderBy: { order: "asc" }, limit: 100 });
const { entries: photos,       cacheHint: galleryCacheHint } = await getEmDashCollection("gallery",      { status: "published", orderBy: { order: "asc" }, limit: 100 });

const martialArtsVideos = allVideos.filter(v => v.data.category === "martial-arts");

try {
  Astro.cache.set(videosCacheHint);
  Astro.cache.set(certsCacheHint);
  Astro.cache.set(galleryCacheHint);
} catch {}

// 3列のグリッドに分割
const COLS = 3;
const rows: (typeof photos)[] = [];
for (let i = 0; i < photos.length; i += COLS) {
  rows.push(photos.slice(i, i + COLS));
}
---

