---
import Base from "../layouts/Base.astro";
import { getEmDashCollection } from "emdash";
import { membersGroupImage, logoImage } from "../components/blocks/images";

const { entries: members, cacheHint } = await getEmDashCollection("members", {
  limit: 100,
});
try { Astro.cache.set(cacheHint); } catch {}
---

<Base
  title="門下生"
  description="泰山流護身術・逮捕術の門下生たち。世界各国から集まった仲間が、東京八王子本部道場で共に稽古に励んでいます。"
>

  <!-- タイトルセクション -->
  <section class="mb-title">
    <div class="mb-inner">
      <div class="mb-title-content reveal">
        <p class="mb-eyebrow">Taizan-ryu</p>
        <h1 class="mb-title-text"><span class="ja">門下生</span><span class="en">Members</span></h1>
        <p class="mb-title-sub">Members</p>
        <div class="mb-divider"></div>
        <p class="mb-title-desc ja">
          世界各国から集まった仲間たちが、守破離の精神のもとで共に稽古に励んでいます。
          国籍・年齢・経験を超えた絆が、泰山流道場を一層豊かなものにしています。
        </p>
        <p class="mb-title-desc en">
          Students from around the world train together in the spirit of Shu-Ha-Ri.
          Bonds that transcend nationality, age, and experience make Taizan-ryu Dojo all the richer.
        </p>
      </div>
    </div>
  </section>

  <!-- ヒーローセクション -->
  <section class="mb-hero">
    <img
      src={membersGroupImage}
      alt="泰山流道場 門下生たち"
      class="mb-hero-bg"
    />
    <div class="mb-hero-overlay"></div>
  </section>

  <!-- リストセクション -->
  <section class="mb-list surface-light">
    <div class="mb-inner">
      <div class="mb-list-header reveal">
        <h2><span class="ja">共に稽古を積む仲間たち</span><span class="en">Training Together as One</span></h2>
        <p><span class="ja">2025年9月現在 - 泰山流護身術認定メンバー</span><span class="en">As of September 2025 — Taizan-ryu Certified Members</span></p>
      </div>

      <div class="mb-grid">
        {members.map((member) => (
          <div class="mb-card reveal">
            <div class="mb-card-photo">
              <img
                src={member.data.photo_url || logoImage}
                alt={member.data.name}
              />
            </div>
            <div class="mb-card-body">
              <h3 class="mb-card-name">{member.data.name}</h3>
              <p class="mb-card-name-en">{member.data.member_id}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

</Base>

<style>
  /* ===== 共通 ===== */
  .mb-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ===== タイトルセクション ===== */
  .mb-title {
    padding: calc(var(--header-height) + 80px) 0 80px;
    background-color: var(--bg-color);
    text-align: center;
  }

  .mb-title-content {
    max-width: 640px;
    margin: 0 auto;
  }

  .mb-eyebrow {
    font-size: 0.8rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .mb-title-text {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 600;
    letter-spacing: 8px;
    line-height: 1;
    margin-bottom: 12px;
  }

  .mb-title-sub {
    font-size: 0.85rem;
    letter-spacing: 5px;
    color: var(--text-secondary);
    margin-bottom: 40px;
  }

  .mb-divider {
    width: 40px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.3);
    margin: 0 auto 40px;
  }

  .mb-title-desc {
    font-size: 0.95rem;
    line-height: 2;
    color: var(--text-secondary);
  }

  /* ===== ヒーローセクション ===== */
  .mb-hero {
    position: relative;
    width: 100%;
    height: 60vh;
    min-height: 360px;
    overflow: hidden;
  }

  .mb-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .mb-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(107, 31, 35, 0.3) 0%,
      rgba(0, 0, 0, 0.5) 100%
    );
  }

  /* ===== リストセクション ===== */
  .mb-list {
    padding: 100px 0;
  }

  .mb-list-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .mb-list-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    letter-spacing: 4px;
    margin-bottom: 14px;
    color: var(--text-primary);
  }

  .mb-list-header p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  /* カードグリッド */
  .mb-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  /* カード */
  .mb-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 20px;
    background-color: #ffffff;
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 10px;
    padding: 16px;
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.3s ease;
  }

  .mb-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.1);
  }

  /* カード写真 */
  .mb-card-photo {
    width: 72px;
    height: 72px;
    flex-shrink: 0;
    border-radius: 8px;
    overflow: hidden;
    background-color: #f0ebe3;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mb-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
    filter: grayscale(15%);
  }

  .mb-card:hover .mb-card-photo img {
    transform: scale(1.06);
    filter: grayscale(0%);
  }

  /* カード本文 */
  .mb-card-body {
    flex: 1;
    min-width: 0;
  }

  .mb-card-name {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    margin-bottom: 4px;
    color: var(--text-on-light);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mb-card-name-en {
    font-size: 0.75rem;
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  /* タグ */
  .mb-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }

  .mb-tag {
    font-size: 0.72rem;
    letter-spacing: 1px;
    padding: 3px 10px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--text-secondary);
  }

  .mb-tag-rank {
    background-color: rgba(107, 31, 35, 0.5);
    border-color: rgba(107, 31, 35, 0.8);
    color: #ffcccc;
  }

  /* 詳細情報 */
  .mb-card-info {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 12px;
    row-gap: 6px;
    font-size: 0.8rem;
  }

  .mb-card-info dt {
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  .mb-card-info dd {
    color: var(--text-primary);
    margin: 0;
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 900px) {
    .mb-inner {
      padding: 0 20px;
    }

    .mb-title {
      padding: calc(var(--header-height) + 48px) 0 60px;
    }

    .mb-list,
    .mb-cta {
      padding: 60px 0;
    }

    .mb-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  @media (max-width: 600px) {
    .mb-grid {
      grid-template-columns: 1fr;
    }

    .mb-hero {
      height: 45vh;
    }
  }
</style>
