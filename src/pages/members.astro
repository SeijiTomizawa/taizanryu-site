---
import Base from "../layouts/Base.astro";
---

<Base
  title="門下生"
  description="泰山流護身術・逮捕術の門下生たち。世界各国から集まった仲間が、東京八王子本部道場で共に稽古に励んでいます。"
>

  <!-- タイトルセクション -->
  <section class="mb-title">
    <div class="mb-inner">
      <div class="mb-title-content reveal">
        <p class="mb-eyebrow">Taizan-ryu</p>
        <h1 class="mb-title-text">門下生</h1>
        <p class="mb-title-sub">Members</p>
        <div class="mb-divider"></div>
        <p class="mb-title-desc">
          世界各国から集まった仲間たちが、守破離の精神のもとで共に稽古に励んでいます。
          国籍・年齢・経験を超えた絆が、泰山流道場を一層豊かなものにしています。
        </p>
      </div>
    </div>
  </section>

  <!-- ヒーローセクション -->
  <section class="mb-hero">
    <img
      src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/dojo/DOJO_08.webp"
      alt="泰山流道場 門下生たち"
      class="mb-hero-bg"
    />
    <div class="mb-hero-overlay"></div>
  </section>

  <!-- リストセクション -->
  <section class="mb-list">
    <div class="mb-inner">

      <div class="mb-list-header reveal">
        <h2>門下生一覧</h2>
        <p>現役門下生のご紹介です。</p>
      </div>

      <div class="mb-grid">

        <div class="mb-card reveal">
          <div class="mb-card-photo">
            <img src="https://picsum.photos/300/300?random=10" alt="門下生" />
          </div>
          <div class="mb-card-body">
            <h3 class="mb-card-name">山田 太郎</h3>
            <p class="mb-card-name-en">Taro Yamada</p>
            <div class="mb-card-tags">
              <span class="mb-tag mb-tag-rank">初段</span>
              <span class="mb-tag">護身術</span>
            </div>
            <dl class="mb-card-info">
              <dt>出身</dt><dd>🇯🇵 日本</dd>
              <dt>入門</dt><dd>2018年</dd>
            </dl>
          </div>
        </div>

        <div class="mb-card reveal">
          <div class="mb-card-photo">
            <img src="https://picsum.photos/300/300?random=11" alt="門下生" />
          </div>
          <div class="mb-card-body">
            <h3 class="mb-card-name">John Smith</h3>
            <p class="mb-card-name-en">ジョン・スミス</p>
            <div class="mb-card-tags">
              <span class="mb-tag mb-tag-rank">二段</span>
              <span class="mb-tag">逮捕術</span>
            </div>
            <dl class="mb-card-info">
              <dt>出身</dt><dd>🇺🇸 アメリカ</dd>
              <dt>入門</dt><dd>2015年</dd>
            </dl>
          </div>
        </div>

        <div class="mb-card reveal">
          <div class="mb-card-photo">
            <img src="https://picsum.photos/300/300?random=12" alt="門下生" />
          </div>
          <div class="mb-card-body">
            <h3 class="mb-card-name">鈴木 花子</h3>
            <p class="mb-card-name-en">Hanako Suzuki</p>
            <div class="mb-card-tags">
              <span class="mb-tag mb-tag-rank">初段</span>
              <span class="mb-tag">護身術</span>
              <span class="mb-tag">指圧</span>
            </div>
            <dl class="mb-card-info">
              <dt>出身</dt><dd>🇯🇵 日本</dd>
              <dt>入門</dt><dd>2020年</dd>
            </dl>
          </div>
        </div>

        <div class="mb-card reveal">
          <div class="mb-card-photo">
            <img src="https://picsum.photos/300/300?random=13" alt="門下生" />
          </div>
          <div class="mb-card-body">
            <h3 class="mb-card-name">Carlos Rivera</h3>
            <p class="mb-card-name-en">カルロス・リベラ</p>
            <div class="mb-card-tags">
              <span class="mb-tag mb-tag-rank">三段</span>
              <span class="mb-tag">逮捕術</span>
            </div>
            <dl class="mb-card-info">
              <dt>出身</dt><dd>🇲🇽 メキシコ</dd>
              <dt>入門</dt><dd>2012年</dd>
            </dl>
          </div>
        </div>

        <div class="mb-card reveal">
          <div class="mb-card-photo">
            <img src="https://picsum.photos/300/300?random=14" alt="門下生" />
          </div>
          <div class="mb-card-body">
            <h3 class="mb-card-name">田中 健</h3>
            <p class="mb-card-name-en">Ken Tanaka</p>
            <div class="mb-card-tags">
              <span class="mb-tag mb-tag-rank">初段</span>
              <span class="mb-tag">護身術</span>
            </div>
            <dl class="mb-card-info">
              <dt>出身</dt><dd>🇯🇵 日本</dd>
              <dt>入門</dt><dd>2021年</dd>
            </dl>
          </div>
        </div>

        <div class="mb-card reveal">
          <div class="mb-card-photo">
            <img src="https://picsum.photos/300/300?random=15" alt="門下生" />
          </div>
          <div class="mb-card-body">
            <h3 class="mb-card-name">Marie Dupont</h3>
            <p class="mb-card-name-en">マリー・デュポン</p>
            <div class="mb-card-tags">
              <span class="mb-tag mb-tag-rank">初段</span>
              <span class="mb-tag">護身術</span>
              <span class="mb-tag">指圧</span>
            </div>
            <dl class="mb-card-info">
              <dt>出身</dt><dd>🇫🇷 フランス</dd>
              <dt>入門</dt><dd>2019年</dd>
            </dl>
          </div>
        </div>

      </div>
    </div>
  </section>

</Base>

<style>
  /* ===== 共通 ===== */
  .mb-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 40px;
  }

  /* ===== タイトルセクション ===== */
  .mb-title {
    padding: calc(var(--header-height) + 80px) 0 80px;
    background-color: var(--bg-color);
    text-align: center;
  }

  .mb-title-content {
    max-width: 640px;
    margin: 0 auto;
  }

  .mb-eyebrow {
    font-size: 0.8rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .mb-title-text {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 600;
    letter-spacing: 8px;
    line-height: 1;
    margin-bottom: 12px;
  }

  .mb-title-sub {
    font-size: 0.85rem;
    letter-spacing: 5px;
    color: var(--text-secondary);
    margin-bottom: 40px;
  }

  .mb-divider {
    width: 40px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.3);
    margin: 0 auto 40px;
  }

  .mb-title-desc {
    font-size: 0.95rem;
    line-height: 2;
    color: var(--text-secondary);
  }

  /* ===== ヒーローセクション ===== */
  .mb-hero {
    position: relative;
    width: 100%;
    height: 60vh;
    min-height: 360px;
    overflow: hidden;
  }

  .mb-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
  }

  .mb-hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(107, 31, 35, 0.3) 0%,
      rgba(0, 0, 0, 0.5) 100%
    );
  }

  /* ===== リストセクション ===== */
  .mb-list {
    padding: 100px 0;
    background-color: var(--bg-color);
  }

  .mb-list-header {
    text-align: center;
    margin-bottom: 64px;
  }

  .mb-list-header h2 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 400;
    letter-spacing: 4px;
    margin-bottom: 14px;
  }

  .mb-list-header p {
    font-size: 0.9rem;
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  /* カードグリッド */
  .mb-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  /* カード */
  .mb-card {
    background-color: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    overflow: hidden;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.35s ease,
                border-color 0.35s ease;
  }

  .mb-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    border-color: rgba(255, 255, 255, 0.18);
  }

  /* カード写真 */
  .mb-card-photo {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: rgba(0, 0, 0, 0.3);
  }

  .mb-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
    filter: grayscale(20%);
  }

  .mb-card:hover .mb-card-photo img {
    transform: scale(1.04);
    filter: grayscale(0%);
  }

  /* カード本文 */
  .mb-card-body {
    padding: 24px;
  }

  .mb-card-name {
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: 2px;
    margin-bottom: 4px;
  }

  .mb-card-name-en {
    font-size: 0.78rem;
    color: var(--text-secondary);
    letter-spacing: 1px;
    margin-bottom: 16px;
  }

  /* タグ */
  .mb-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 18px;
  }

  .mb-tag {
    font-size: 0.72rem;
    letter-spacing: 1px;
    padding: 3px 10px;
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--text-secondary);
  }

  .mb-tag-rank {
    background-color: rgba(107, 31, 35, 0.5);
    border-color: rgba(107, 31, 35, 0.8);
    color: #ffcccc;
  }

  /* 詳細情報 */
  .mb-card-info {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 12px;
    row-gap: 6px;
    font-size: 0.8rem;
  }

  .mb-card-info dt {
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  .mb-card-info dd {
    color: var(--text-primary);
    margin: 0;
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 900px) {
    .mb-inner {
      padding: 0 20px;
    }

    .mb-title {
      padding: calc(var(--header-height) + 48px) 0 60px;
    }

    .mb-list,
    .mb-cta {
      padding: 60px 0;
    }

    .mb-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 600px) {
    .mb-grid {
      grid-template-columns: 1fr;
    }

    .mb-hero {
      height: 45vh;
    }
  }
</style>
