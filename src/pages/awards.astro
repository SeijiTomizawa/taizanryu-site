---
import Base from "../layouts/Base.astro";

const R2 = "https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev";
const P  = "https://picsum.photos/800/600?random=";

// 4行 × 3列 — 各セルに画像を3枚（自動切り替え用）
const rows: string[][][] = [
  [
    [`${R2}/dojo/DOJO_04.webp`,            `${P}20`, `${P}21`],
    [`${R2}/dojo/DOJO_05.webp`,            `${P}22`, `${P}23`],
    [`${R2}/dojo/DOJO_07.webp`,            `${P}24`, `${P}25`],
  ],
  [
    [`${R2}/dojo/DOJO_08.webp`,            `${P}26`, `${P}27`],
    [`${R2}/shiatsu/SHIATSU_DO_02.webp`,   `${P}28`, `${P}29`],
    [`${R2}/biography/SOKE_JOE_MILLER.webp`, `${P}30`, `${P}31`],
  ],
  [
    [`${R2}/parts/big-photo0000-6654.jpg`, `${P}32`, `${P}33`],
    [`${P}34`, `${P}35`, `${P}36`],
    [`${P}37`, `${P}38`, `${P}39`],
  ],
  [
    [`${P}40`, `${P}41`, `${P}42`],
    [`${P}43`, `${P}44`, `${P}45`],
    [`${P}46`, `${P}47`, `${P}48`],
  ],
];
---

<Base
  title="ギャラリー"
  description="泰山流護身術・逮捕術 道場写真ギャラリー。稽古・演武・道場の様子をご覧ください。"
>

  <!-- タイトルセクション -->
  <section class="gl-title">
    <div class="gl-title-inner reveal">
      <p class="gl-eyebrow">Taizan-ryu</p>
      <h1 class="gl-title-text"><span class="ja">ギャラリー</span><span class="en">Gallery</span></h1>
      <p class="gl-title-sub">Gallery</p>
      <div class="gl-divider"></div>
      <p class="gl-title-desc ja">道場での稽古・演武・行事の様子をご紹介します。</p>
      <p class="gl-title-desc en">Showcasing dojo training, demonstrations, and events.</p>
    </div>
  </section>

  <!-- フォトグリッド -->
  <section class="gl-section">
    {rows.map((row, rowIdx) => (
      <div
        class={`gl-row gl-row--${rowIdx % 2 === 0 ? 'from-right' : 'from-left'}`}
        data-row={rowIdx}
      >
        {row.map((imgs, colIdx) => (
          <div
            class="gl-cell"
            data-row={rowIdx}
            data-index={rowIdx * 3 + colIdx}
          >
            {imgs.map((src, i) => (
              <img
                src={src}
                alt={`ギャラリー ${rowIdx * 3 + colIdx + 1}-${i + 1}`}
                class={`gl-img${i === 0 ? ' gl-img--active' : ''}`}
                loading="lazy"
              />
            ))}
          </div>
        ))}
      </div>
    ))}
  </section>

</Base>

<script>
  // ===== 行フェードイン（スクロール連動） =====
  const rowObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('gl-row--revealed');
        rowObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.08 });

  document.querySelectorAll('.gl-row').forEach(row => rowObs.observe(row));

  // ===== セル内画像のクロスフェード切り替え =====
  const DURATION = 1800;  // フェード時間 ms
  const INTERVAL = 7000;  // 切り替え間隔 ms
  const STAGGER  = 600;   // セルごとの遅延 ms

  document.querySelectorAll<HTMLElement>('.gl-cell').forEach((cell) => {
    const cellIdx = parseInt(cell.dataset.index ?? '0');
    const imgs    = Array.from(cell.querySelectorAll<HTMLImageElement>('.gl-img'));
    if (imgs.length < 2) return;

    let current   = 0;
    let animating = false;

    function cycle() {
      if (animating) return;
      animating = true;

      const next = (current + 1) % imgs.length;

      // 次の画像を透明で重ねる
      imgs[next].style.transition = 'none';
      imgs[next].style.opacity    = '0';
      imgs[next].style.zIndex     = '2';

      requestAnimationFrame(() => requestAnimationFrame(() => {
        imgs[next].style.transition = `opacity ${DURATION}ms ease-in-out`;
        imgs[next].style.opacity    = '1';

        setTimeout(() => {
          imgs[current].style.zIndex = '0';
          imgs[current].style.opacity = '0';
          imgs[next].style.zIndex    = '1';
          current   = next;
          animating = false;
        }, DURATION + 50);
      }));
    }

    setTimeout(() => setInterval(cycle, INTERVAL), cellIdx * STAGGER);
  });
</script>

<style>
  /* ===== タイトル ===== */
  .gl-title {
    padding: calc(var(--header-height) + 80px) 0 72px;
    background-color: var(--bg-color);
    text-align: center;
  }

  .gl-title-inner {
    max-width: 520px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .gl-eyebrow {
    font-size: 0.8rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .gl-title-text {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 600;
    letter-spacing: 8px;
    line-height: 1;
    margin-bottom: 12px;
  }

  .gl-title-sub {
    font-size: 0.85rem;
    letter-spacing: 5px;
    color: var(--text-secondary);
    margin-bottom: 36px;
  }

  .gl-divider {
    width: 40px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.25);
    margin: 0 auto 36px;
  }

  .gl-title-desc {
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  /* ===== グリッド ===== */
  .gl-section {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background-color: #0d0806;
    padding: 0;
  }

  /* ===== 行（フェードイン用） ===== */
  .gl-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 1.8s ease, transform 2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gl-row--from-right { transform: translateY(16px); }
  .gl-row--from-left  { transform: translateY(16px); }

  .gl-row--revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== セル ===== */
  .gl-cell {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: #1a120d;
  }

  /* ===== 画像 ===== */
  .gl-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    z-index: 0;
    will-change: transform;
  }

  .gl-img--active {
    opacity: 1;
    z-index: 1;
  }

  /* ホバーで少し明るく */
  .gl-cell:hover .gl-img--active {
    filter: brightness(1.08);
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 900px) {
    .gl-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .gl-row {
      grid-template-columns: 1fr;
    }
    .gl-title { padding: calc(var(--header-height) + 48px) 0 48px; }
  }
</style>
