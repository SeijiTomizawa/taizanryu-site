---
import { getEmDashCollection } from "emdash";
import Base from "../layouts/Base.astro";

const { entries: photos, cacheHint } = await getEmDashCollection("gallery", {
  status: "published",
  orderBy: { order: "asc" },
  limit: 100,
});
Astro.cache.set(cacheHint);

// 3列のグリッドに分割
const COLS = 3;
const rows: (typeof photos)[] = [];
for (let i = 0; i < photos.length; i += COLS) {
  rows.push(photos.slice(i, i + COLS));
}
---

<Base
  title="ギャラリー"
  description="泰山流護身術・逮捕術 道場写真ギャラリー。稽古・演武・道場の様子をご覧ください。"
>

  <!-- タイトルセクション -->
  <section class="gl-title">
    <div class="gl-title-inner reveal">
      <p class="gl-eyebrow">Taizan-ryu</p>
      <h1 class="gl-title-text"><span class="ja">ギャラリー</span><span class="en">Gallery</span></h1>
      <p class="gl-title-sub">Gallery</p>
      <div class="gl-divider"></div>
      <p class="gl-title-desc ja">道場での稽古・演武・行事の様子をご紹介します。</p>
      <p class="gl-title-desc en">Showcasing dojo training, demonstrations, and events.</p>
    </div>
  </section>

  <!-- フォトグリッド -->
  <section class="gl-section">
    {rows.map((row, rowIdx) => (
      <div
        class={`gl-row gl-row--${rowIdx % 2 === 0 ? 'from-right' : 'from-left'}`}
        data-row={rowIdx}
      >
        {row.map((photo, colIdx) => (
          <div
            class="gl-cell"
            data-index={rowIdx * COLS + colIdx}
          >
            <img
              src={photo.data.image?.src ?? (photo.data.image as unknown as string)}
              alt={photo.data.caption ?? `ギャラリー ${rowIdx * COLS + colIdx + 1}`}
              class="gl-img gl-img--active"
              loading="lazy"
            />
          </div>
        ))}
      </div>
    ))}
  </section>

</Base>

<script>
  // ===== 行フェードイン（スクロール連動） =====
  const rowObs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        e.target.classList.add('gl-row--revealed');
        rowObs.unobserve(e.target);
      }
    });
  }, { threshold: 0.08 });

  document.querySelectorAll('.gl-row').forEach(row => rowObs.observe(row));
</script>

<style>
  /* ===== タイトル ===== */
  .gl-title {
    padding: calc(var(--header-height) + 80px) 0 72px;
    background-color: var(--bg-color);
    text-align: center;
  }

  .gl-title-inner {
    max-width: 520px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .gl-eyebrow {
    font-size: 0.8rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .gl-title-text {
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 600;
    letter-spacing: 8px;
    line-height: 1;
    margin-bottom: 12px;
  }

  .gl-title-sub {
    font-size: 0.85rem;
    letter-spacing: 5px;
    color: var(--text-secondary);
    margin-bottom: 36px;
  }

  .gl-divider {
    width: 40px;
    height: 1px;
    background-color: rgba(255, 255, 255, 0.25);
    margin: 0 auto 36px;
  }

  .gl-title-desc {
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--text-secondary);
    letter-spacing: 1px;
  }

  /* ===== グリッド ===== */
  .gl-section {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background-color: #0d0806;
    padding: 0;
  }

  /* ===== 行（フェードイン用） ===== */
  .gl-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 1.8s ease, transform 2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gl-row--revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* ===== セル ===== */
  .gl-cell {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background-color: #1a120d;
  }

  /* ===== 画像 ===== */
  .gl-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease, filter 0.5s ease;
    filter: grayscale(15%);
  }

  .gl-cell:hover .gl-img {
    transform: scale(1.04);
    filter: grayscale(0%) brightness(1.08);
  }

  /* ===== レスポンシブ ===== */
  @media (max-width: 900px) {
    .gl-row {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .gl-row {
      grid-template-columns: 1fr;
    }
    .gl-title { padding: calc(var(--header-height) + 48px) 0 48px; }
  }
</style>
