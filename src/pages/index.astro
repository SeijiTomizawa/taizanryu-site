---
import { getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import MarketingBlocks from "../components/MarketingBlocks.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");

try {
  Astro.cache.set(cacheHint);
} catch {}

const pageTitle = page?.data.title;
const pageContent = page?.data.content;
---

<Base
  title={pageTitle !== "Home" ? pageTitle : undefined}
  description="Painting is my passion. Fine Arts Portfolio."
>
  {
    pageContent && (
      <MarketingBlocks value={pageContent} />
    )
  }

  <div class="container" id="home">
    
    <section class="hero">
      <div class="hero-left">
        <h1 class="fade-in-title">
          <span class="line-1">FINE ARTS</span><br>
          <span class="line-2">PORTFOLIO</span>
        </h1>
        <img src="https://picsum.photos/400/300?random=1" alt="Woman playing guitar" class="hero-img-1 hero-fade" />
      </div>
      <div class="hero-center">
        <img src="https://picsum.photos/350/600?random=2" alt="Couple walking" class="hero-img-2 hero-fade" />
      </div>
      <div class="hero-right">
        <img src="https://picsum.photos/400/250?random=3" alt="Tiger" class="hero-img-3 hero-fade" />
        <p class="author-name hero-fade">GIONAN CHUALD<br>PAINTER</p>
      </div>
    </section>

    <section class="about" id="about">
      <div class="about-text">
        <img src="https://picsum.photos/100/100?random=4" alt="Artist Portrait" class="avatar reveal" />
        <h2 class="reveal">Painting is my passion.<br>I see beauty in all things<br>and I paint what I see.</h2>
        <p class="reveal">I have been painting for 40 years. Nature is my main inspiration. I love to capture the light and colors of the seasons. I am always experimenting with new techniques and materials.</p>
      </div>
      <div class="about-image">
        <img src="https://picsum.photos/500/400?random=5" alt="Hand painting" class="reveal" />
      </div>
    </section>

    <section class="background-exhibits" id="background">
      <div class="be-text">
        <div class="be-block reveal">
          <h3>MY BACKGROUND</h3>
          <ul>
            <li>BA in Fine Arts, University of Paris</li>
            <li>MFA in Painting, London Art College</li>
          </ul>
        </div>
        <div class="be-block reveal">
          <h3>EXHIBITS</h3>
          <ul>
            <li>"Colors of Spring" - City Gallery, Paris (2020)</li>
            <li>"Light & Shadow" - Modern Art Museum, NY (2018)</li>
          </ul>
        </div>
      </div>
      <div class="be-image">
        <img src="https://picsum.photos/600/700?random=6" alt="Garden painting" class="reveal" />
      </div>
    </section>

    <section class="featured-works" id="works">
      <h6 class="section-subtitle reveal">MY FEATURED WORKS</h6>
      <div class="work-list">
        <div class="work-item reveal">
          <span class="work-num">01</span>
          <img src="https://picsum.photos/300/150?random=7" alt="Gardens in Blue" />
          <div class="work-details">
            <h3>GARDENS IN BLUE</h3>
          </div>
        </div>
        <div class="work-item reveal">
          <span class="work-num">02</span>
          <img src="https://picsum.photos/300/150?random=8" alt="Platter #2" />
          <div class="work-details">
            <h3>PLATTER #2</h3>
          </div>
        </div>
      </div>
    </section>

    <section class="gallery-grid">
      <img src="https://picsum.photos/400/250?random=12" alt="Gallery 1" class="reveal" />
      <img src="https://picsum.photos/400/250?random=13" alt="Gallery 2" class="reveal" />
      <img src="https://picsum.photos/400/250?random=14" alt="Gallery 3" class="reveal" />
      <img src="https://picsum.photos/400/250?random=15" alt="Gallery 4" class="reveal" />
    </section>

    <section class="contact" id="contact">
      <div class="contact-title reveal">
        <h2>GET IN<br>TOUCH</h2>
      </div>
      <div class="contact-image">
        <img src="https://picsum.photos/400/500?random=21" alt="Artist portrait" class="reveal" />
      </div>
    </section>

  </div>
</Base>

<style>
  /* 各セクション固有のレイアウトスタイル */
  .hero { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 30px; }
  .hero h1 { font-size: 3rem; margin-bottom: 40px; }
  .hero-img-2 { height: 600px; object-fit: cover; }
  .author-name { text-align: right; font-size: 0.8rem; letter-spacing: 2px; }

  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .avatar { width: 80px; height: 80px; border-radius: 50%; margin-bottom: 30px; }
  .about h2 { font-size: 2rem; margin-bottom: 20px; font-weight: 400; }

  .background-exhibits { display: grid; grid-template-columns: 1fr 1.5fr; gap: 60px; }
  .be-text { display: flex; flex-direction: column; gap: 40px; }
  
  .work-list { display: flex; flex-direction: column; gap: 30px; }
  .work-item { display: flex; align-items: center; gap: 30px; }
  .work-item img { width: 250px; height: 120px; object-fit: cover; }

  .gallery-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

  .contact { display: grid; grid-template-columns: 1fr 2fr; gap: 40px; align-items: end; }
  .contact-title h2 { font-size: 3rem; }

  @media (max-width: 900px) {
    .container { padding-left: 20px; padding-right: 20px; }
    .hero, .about, .background-exhibits, .contact { grid-template-columns: 1fr; }
    .hero-img-2 { height: 400px; }
  }
</style>