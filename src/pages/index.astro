---
import { getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import MarketingBlocks from "../components/MarketingBlocks.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");

try {
  Astro.cache.set(cacheHint);
} catch {}

const pageTitle = page?.data.title;
const pageContent = page?.data.content;

/**
   * ヒーローカルーセルの画像切り替え (フェード)
   */
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.carousel-slide');
    if (slides.length === 0) return;

    let currentSlide = 0;
    const intervalTime = 5000; // 5000ミリ秒 (5秒) ごとに切り替え

    function nextSlide() {
      // 現在の画像をフェードアウト
      slides[currentSlide].classList.remove('active');
      
      // 次の画像のインデックスを計算
      currentSlide = (currentSlide + 1) % slides.length;
      
      // 次の画像をフェードイン
      slides[currentSlide].classList.add('active');
    }

    // タイマー開始
    setInterval(nextSlide, intervalTime);
  });

---

<Base
  title={pageTitle !== "Home" ? pageTitle : undefined}
  description="Painting is my passion. Fine Arts Portfolio."
>
  {
    pageContent && (
      <MarketingBlocks value={pageContent} />
    )
  }

  <div class="container" id="home">
    
<section class="hero-carousel">
      <div class="carousel-images">
        <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/dojo/DOJO_04.webp" alt="Dojo 04" class="carousel-slide active" />
        <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/dojo/DOJO_08.webp" alt="Dojo 08" class="carousel-slide" />
        <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/dojo/DOJO_07.webp" alt="Dojo 07" class="carousel-slide" />
      </div>
      
      <div class="carousel-overlay"></div>

      <div class="carousel-content">
        <h1 class="hero-title">
          <span class="line-1">泰山流護身術・逮捕術</span><br>
          <span class="line-2">- 東京八王子本部道場 -</span>
        </h1>
        <p class="hero-subtitle">Peaceful Mountain System</p>
        <p class="hero-author">守破離の精神で、真の護身を。</p>
      </div>
    </section>

    <section class="self-defense" id="self-defense">
      <div class="about-text">
        <h2 class="reveal">泰山流護身術・逮捕術</h2>
        <p class="reveal">60年以上の武道経験に基づく実践的な護身術。合気柔術、柔道、空手の技術を統合し、現代社会に適応した効果的な防御システムを学びます。</p>
      </div>
      <a href="/self-defense" class="about-image">
        <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/dojo/DOJO_05.webp" alt="柔術稽古" class="reveal" />
      </a>
    </section>

    <section class="shiatsu" id="shiatsu">
      <div class="about-text">
        <h2 class="reveal">泰山流指圧整体院</h2>
        <p class="reveal">武道の知識と経験を活かした独自の整体・指圧療法。身体のバランスを整え、自然治癒力を高めることで、心身の健康をサポートします。</p>
      </div>
      <a href="/shiatsu" class="about-image">
        <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/shiatsu/SHIATSU_DO_02.webp" alt="指圧治療院" class="reveal" />
      </a>
    </section>

    <section class="background-exhibits" id="background">
      <div class="be-text">
        <div class="be-block reveal">
          <h3>宗家について</h3>
          <p>伝統的な術から独立し、泰山流を創始。実戦的な護身術「逮捕術（Taiho Jutsu）」と、心身を癒す「泰山流指圧」の両面から、バランスの取れた武道を指導しています。現在、選ばれた少数の生徒のみと完全予約制でクラスを行っています。</p>
        </div>
      </div>
      <a href="/soke" class="be-image">
        <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/biography/SOKE_JOE_MILLER.webp" alt="宗家ジョー・ミラー" class="reveal" />
      </a>
    </section>

    <section class="emblem" id="emblem">
      <div class="banner-image">
        <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/parts/LOGO.webp" alt="泰山流エンブレム" class="reveal" />
      </div>
    </section>

    <section class="featured-works" id="works">
      <dl>
        <dt>
          <span class="work-num">01</span>
          <a href="">
            <img src="https://picsum.photos/300/150?random=7" alt="Gardens in Blue" />
          </a>
          <h3>国境を越えて集う仲間たち</h3>
        </dt>
        <dd>
          世界中から集まった生徒たちが、泰山流の技術と精神を学び、共に成長しています。国籍や背景を超えた絆が、道場を一層豊かなものにしています。
        </dd>
        <dt>
          <span class="work-num">02</span>
          <a href="/training">
            <img src="https://picsum.photos/300/150?random=8" alt="Platter #2" />
          </a>
          <h3>稽古仲間たち</h3>
        </dt>
        <dd>
          稽古で培った絆と信頼。同じ目標に向かって努力する、様々な国籍、年齢、経験レベルの仲間たちとの交流は、武道の成長に欠かせない要素です。
        </dd>
        <dt>
          <span class="work-num">03</span>
          <a href="/techniques">
            <img src="https://picsum.photos/300/150?random=8" alt="Platter #2" />
          </a>
          <h3>泰山流の技術</h3>
        </dt>
        <dd>
          宗家ジョー・ミラーによる技術解説と、道場での稽古の様子をご覧ください。基本技術から実戦応用まで、映像を通じて泰山流の技術と哲学を体験できます。
        </dd>
      </dl>
    </section>

    <section class="access" id="access">
      <h3>アクセス</h3>
      <div class="access-hero">
        <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/parts/big-photo0000-6654.jpg" 
          alt="八王子駅前" class="reveal"
          width="100%" height="200" style="border:0;"
        />
      </div>
      <div class="access-info">
        <p>東京都八王子市子安町1-29-1</p>
        <p>八王子駅南口より徒歩5分</p>
        <p>新宿駅から30分、日本全国からアクセス良好</p>
      </div>
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3240.1234567890123!2d139.1234567890123!3d35.1234567890123!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x123456789012345%3A0x123456789012345!2sHachioji%20Station%20South%20Exit!5e0!3m2!1sen!2sjp!4v1234567890123"
        width="100%"
        height="300"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </section>

  </div>
</Base>

<style>
  /* 各セクション固有のレイアウトスタイル */
  .hero { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 30px; }
  .hero h1 { font-size: 3rem; margin-bottom: 40px; }
  .hero-img-2 { height: 600px; object-fit: cover; }
  .author-name { text-align: right; font-size: 0.8rem; letter-spacing: 2px; }

  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
  .avatar { width: 80px; height: 80px; border-radius: 50%; margin-bottom: 30px; }
  .about h2 { font-size: 2rem; margin-bottom: 20px; font-weight: 400; }

  .background-exhibits { display: grid; grid-template-columns: 1fr 1.5fr; gap: 60px; }
  .be-text { display: flex; flex-direction: column; gap: 40px; }
  
  .featured-works dl { display: flex; flex-direction: column; gap: 50px; }
  .featured-works dt { display: flex; align-items: center; gap: 30px; }
  .featured-works .work-num { font-size: 2rem; font-weight: 600; color: var(--text-secondary); }
  .featured-works img { width: 300px; height: 150px; object-fit: cover; border-radius: 8px; }
  .featured-works h3 { font-size: 1.5rem; margin: 0; }
  .featured-works dd { margin-left: 80px; font-size: 1rem; color: var(--text-secondary); }

  .emblem { text-align: center; margin: 80px 0; background-color: var(--bg-color-secondary); padding: 40px; width: 100%; height: 300px; display: flex; justify-content: center; align-items: center; }
  .emblem img { width: 200px; height: 200px; object-fit: contain; }

  .contact { display: grid; grid-template-columns: 1fr 2fr; gap: 40px; align-items: end; }
  .contact-title h2 { font-size: 3rem; }

  @media (max-width: 900px) {
    .container { padding-left: 20px; padding-right: 20px; }
    .hero, .about, .background-exhibits, .contact { grid-template-columns: 1fr; }
    .hero-img-2 { height: 400px; }
  }

  /* --- ヒーローカルーセル (全画面幅) --- */
  .hero-carousel {
    position: relative;
    width: 100vw;
    height: 80vh; /* 画面高さの80% (お好みで100vhに変更してください) */
    left: 50%;
    transform: translateX(-50%); /* .containerの枠を突破して全幅にするトリック */
    margin-top: -100px; /* Base.astro等で設定された余白を相殺して上に詰める場合 */
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* 背景画像グループ */
  .carousel-images {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .carousel-slide {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.5s ease-in-out; /* 1.5秒かけてフェードイン/アウト */
  }

  .carousel-slide.active {
    opacity: 1;
  }

  /* テキストの視認性を上げるオーバーレイ */
  .carousel-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.4); /* 黒の半透明 */
    z-index: 2;
  }

  /* 中央配置のテキストコンテンツ */
  .carousel-content {
    position: relative;
    z-index: 3;
    text-align: center;
    color: #ffffff;
    padding: 0 20px;
  }

  /* ふわっと表示されるアニメーション */
  .hero-title,
  .hero-subtitle,
  .hero-author {
    opacity: 0;
    transform: translateY(30px);
    animation: floatUp 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .hero-title { animation-delay: 0.2s; margin-bottom: 20px; }
  .hero-subtitle { animation-delay: 0.6s; font-size: 1.2rem; letter-spacing: 3px; }
  .hero-author { animation-delay: 1.0s; font-size: 1rem; margin-top: 40px; letter-spacing: 2px; }

  .line-1 { font-size: 3.5rem; font-weight: 600; letter-spacing: 4px; display: inline-block; margin-bottom: 10px; }
  .line-2 { font-size: 1.5rem; letter-spacing: 2px; font-weight: 300; }

  @keyframes floatUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* スマホ対応 */
  @media (max-width: 900px) {
    .line-1 { font-size: 2rem; }
    .line-2 { font-size: 1.1rem; }
    .hero-subtitle { font-size: 1rem; }
    .hero-carousel { height: 60vh; }
  }

  /* 元の .hero 関連のCSS (不要になりますが、念のため上書きまたは削除してください) */
  /* .hero { display: grid; ... } 等は削除可能です */

</style>