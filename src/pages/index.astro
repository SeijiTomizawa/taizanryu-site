---
import { getEmDashEntry } from "emdash";
import Base from "../layouts/Base.astro";
import MarketingBlocks from "../components/MarketingBlocks.astro";

const { entry: page, cacheHint } = await getEmDashEntry("pages", "home");

try {
  Astro.cache.set(cacheHint);
} catch {}

const pageTitle = page?.data.title;
const pageContent = page?.data.content;
---

<Base
  title={pageTitle !== "Home" ? pageTitle : undefined}
  description="泰山流護身術・逮捕術 - Peaceful Mountain System"
>
  {
    pageContent && (
      <MarketingBlocks value={pageContent} />
    )
  }

  <div class="container" id="home">
    
    <section class="hero-carousel">
      <div class="carousel-images">
        <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/dojo/DOJO_04.webp" alt="Dojo 04" class="carousel-slide active" />
        <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/dojo/DOJO_08.webp" alt="Dojo 08" class="carousel-slide" />
        <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/dojo/DOJO_07.webp" alt="Dojo 07" class="carousel-slide" />
      </div>
      
      <div class="carousel-overlay"></div>

      <div class="carousel-content">
        <h1 class="hero-title">
          <span class="line-1">泰山流護身術・逮捕術</span><br>
          <span class="line-2">- 東京八王子本部道場 -</span>
        </h1>
        <h2 class="hero-subtitle">Peaceful Mountain System</h2>
        <p class="hero-author">守破離の精神で、真の護身を。</p>
      </div>
    </section>

<section class="features-section" id="features">
      <div class="feature-grid">
        
        <a href="/self-defense" class="feature-card reveal">
          <div class="feature-image-wrapper">
            <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/dojo/DOJO_05.webp" alt="柔術稽古" />
          </div>
          <div class="feature-text">
            <h2>泰山流護身術・逮捕術</h2>
            <p>60年以上の武道経験に基づく実践的な護身術。合気柔術、柔道、空手の技術を統合し、現代社会に適応した効果的な防御システムを学びます。</p>
          </div>
        </a>

        <a href="/shiatsu" class="feature-card reveal">
          <div class="feature-image-wrapper">
            <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/shiatsu/SHIATSU_DO_02.webp" alt="指圧治療院" />
          </div>
          <div class="feature-text">
            <h2>泰山流指圧整体院</h2>
            <p>武道の知識と経験を活かした独自の整体・指圧療法。身体のバランスを整え、自然治癒力を高めることで、心身の健康をサポートします。</p>
          </div>
        </a>

        <a href="/soke" class="feature-card reveal">
          <div class="feature-image-wrapper">
            <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/biography/SOKE_JOE_MILLER.webp" alt="宗家ジョー・ミラー" />
          </div>
          <div class="feature-text">
            <h2>宗家について</h2>
            <p>伝統的な術から独立し、泰山流を創始。実戦的な護身術「逮捕術」と、心身を癒す「泰山流指圧」の両面から、バランスの取れた武道を指導しています。</p>
          </div>
        </a>

      </div>
    </section>

    <section class="emblem" id="emblem">
      <div class="banner-image">
        <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/parts/LOGO.webp" alt="泰山流エンブレム" class="reveal" />
      </div>
    </section>

    <section class="featured-works" id="works">
      <dl>
        <dt class="reveal">
          <span class="work-num">01</span>
          <img src="https://picsum.photos/300/150?random=7" alt="Gardens in Blue" />
        </dt>
        <dd class="reveal">
          <h3>国境を越えて集う仲間たち</h3>
          世界中から集まった生徒たちが、泰山流の技術と精神を学び、共に成長しています。国籍や背景を超えた絆が、道場を一層豊かなものにしています。
          <a href="/training" class="btn">詳細を見る</a>
        </dd>
        <dt class="reveal">
          <span class="work-num">02</span>
          <img src="https://picsum.photos/300/150?random=8" alt="Platter #2" />
        </dt>
        <dd class="reveal">
          <h3>稽古仲間たち</h3>
          稽古で培った絆と信頼。同じ目標に向かって努力する、様々な国籍、年齢、経験レベルの仲間たちとの交流は、武道の成長に欠かせない要素です。
          <a href="/training" class="btn">詳細を見る</a>  
        </dd>
        <dt class="reveal">
          <span class="work-num">03</span>
          <img src="https://picsum.photos/300/150?random=8" alt="Platter #2" />
        </dt>
        <dd class="reveal">
          <h3>泰山流の技術</h3>
          宗家ジョー・ミラーによる技術解説と、道場での稽古の様子をご覧ください。基本技術から実戦応用まで、映像を通じて泰山流の技術と哲学を体験できます。
          <a href="/techniques" class="btn">詳細を見る</a>
        </dd>
      </dl>
    </section>

    <section class="access reveal" id="access">
      <h3>アクセス</h3>
      <div class="access-hero">
        <img src="https://pub-488a24026ed4411b8d591260b603cdd1.r2.dev/parts/big-photo0000-6654.jpg" 
          alt="八王子駅前"
          width="100%" height="200" style="border:0; object-fit: cover; margin-bottom: 20px;"
        />
      </div>
      <div class="access-info" style="margin-bottom: 20px;">
        <p>東京都八王子市子安町1-29-1</p>
        <p>八王子駅南口より徒歩5分</p>
        <p>新宿駅から30分、日本全国からアクセス良好</p>
      </div>
      <iframe
        src="https://maps.app.goo.gl/sstfR73Vs9hrdtAF7"
        width="100%"
        height="300"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </section>

  </div>
</Base>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.carousel-slide');
    if (slides.length === 0) return;

    let currentSlide = 0;
    const intervalTime = 5000;

    function nextSlide() {
      slides[currentSlide].classList.remove('active');
      currentSlide = (currentSlide + 1) % slides.length;
      slides[currentSlide].classList.add('active');
    }

    setInterval(nextSlide, intervalTime);
  });
</script>

<style>
  /* --- レイアウトスタイル --- */
  .emblem { 
    text-align: center; 
    background-color: var(--bg-color-secondary); 
    padding: 40px; 
    width: 100vw;
    display: flex; 
    justify-content: center; 
    align-items: center; 
  }
  .emblem img { 
    width: 200px; 
    height: 200px; 
    object-fit: contain; 
  }

  .access h3 { font-size: 2rem; margin-bottom: 30px; }
  /* --- 統合セクション (カードレイアウト) --- */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr); /* 3列のグリッド */
    gap: 40px;
  }

  /* カード全体のスタイル */
  .feature-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  /* 画像のラッパー（背景白、サイズ統一、ホバーエフェクト） */
  .feature-image-wrapper {
    background-color: #ffffff; /* 背景を白に */
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 4 / 3; /* すべての画像を 4:3 の比率で統一 */
    display: flex;
    justify-content: center;
    align-items: center;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.4s ease;
  }

  /* 画像自体の設定 */
  .feature-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover; /* 枠に合わせてトリミング。余白を残したい場合は 'contain' に変更 */
    transition: transform 0.4s ease;
  }

  /* ホバー時のエフェクト（ふわっと浮き上がり、影がつく） */
  .feature-card:hover .feature-image-wrapper {
    transform: translateY(-10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.6);
  }

  /* テキスト部分のスタイル */
  .feature-text {
    padding: 25px 10px 10px 10px;
  }

  .feature-text h2 {
    font-size: 1.5rem;
    margin-bottom: 15px;
    font-weight: 500;
    transition: color 0.3s ease;
  }

  .feature-text p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ホバー時にタイトル文字色を少し変える（任意） */
  .feature-card:hover .feature-text h2 {
    color: #e0d5ce;
  }

  /* スマホ・タブレット用レスポンシブ対応 */
  @media (max-width: 900px) {
    .feature-grid {
      grid-template-columns: 1fr; /* スマホでは縦1列に */
      gap: 50px;
    }
  }

  /* --- ヒーローカルーセル (全画面幅) --- */
  .hero-carousel {
    position: relative;
    width: 100vw;
    height: 80vh; 
    left: 50%;
    transform: translateX(-50%); 
    margin-top: -100px; 
    margin-bottom: 60px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .carousel-images { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }
  .carousel-slide { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 1.5s ease-in-out; }
  .carousel-slide.active { opacity: 1; }
  .carousel-overlay { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.5); z-index: 2; }

  .carousel-content { position: relative; z-index: 3; text-align: center; color: #ffffff; padding: 0 20px; }

  .hero-title, .hero-subtitle, .hero-author {
    opacity: 0;
    transform: translateY(30px);
    animation: floatUp 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  .hero-title { animation-delay: 0.2s; margin-bottom: 20px; }
  .hero-subtitle { animation-delay: 0.6s; font-size: 1.2rem; letter-spacing: 3px; }
  .hero-author { animation-delay: 1.0s; font-size: 1rem; margin-top: 40px; letter-spacing: 2px; }

  .line-1 { font-size: 3.5rem; font-weight: 600; letter-spacing: 4px; display: inline-block; margin-bottom: 10px; }
  .line-2 { font-size: 3rem; letter-spacing: 2px; font-weight: 300; }

  @keyframes floatUp { to { opacity: 1; transform: translateY(0); } }

  /* --- スマホ・タブレット用レスポンシブ対応 --- */
  @media (max-width: 900px) {
    .container { padding-left: 20px; padding-right: 20px; }
    .self-defense, .shiatsu, .background-exhibits { grid-template-columns: 1fr; gap: 40px; }
    
    .featured-works dt { flex-direction: column; align-items: flex-start; gap: 15px; }
    .featured-works img { width: 100%; height: auto; }
    .featured-works dd { margin-left: 0; }

    .line-1 { font-size: 2rem; }
    .line-2 { font-size: 1.1rem; }
    .hero-subtitle { font-size: 1rem; }
    .hero-carousel { height: 60vh; }
  }

  /* --- Featured Works (横並び & ボタン) --- */
  .featured-works dl {
    display: grid;
    grid-template-columns: auto 1fr; /* dtを左、ddを右の残りのスペースに配置 */
    align-items: center; /* 縦方向の中央揃え */
    column-gap: 50px; /* 左右の余白 */
    row-gap: 60px;    /* 上下の余白 */
  }

  .featured-works dt {
    display: flex;
    align-items: center;
    gap: 25px;
    margin: 0;
  }

  .featured-works .work-num {
    font-size: 2rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .featured-works img {
    width: 300px;
    height: 150px;
    object-fit: cover;
    border-radius: 8px;
  }

  .featured-works dd {
    margin: 0;
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.8;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 15px; /* 見出し、テキスト、ボタン間の余白 */
  }

  .featured-works h3 {
    font-size: 1.5rem;
    color: var(--text-primary);
    margin: 0;
  }

  /* --- 空色のリンクボタン --- */
  .featured-works .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #38bdf8; /* 鮮やかな空色 */
    color: #0f172a; /* 視認性を高めるための濃い文字色 */
    padding: 10px 28px;
    border-radius: 30px; /* 角丸 */
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: background-color 0.3s ease, transform 0.3s ease, box-shadow 0.3s ease;
    margin-top: 10px;
  }

  .featured-works .btn:hover {
    background-color: #7dd3fc; /* ホバー時は少し明るい空色に */
    transform: translateY(-3px); /* ふわっと浮く */
    box-shadow: 0 10px 20px rgba(56, 189, 248, 0.3); /* 空色の影 */
  }

  /* --- スマホ用レスポンシブ対応 --- */
  @media (max-width: 900px) {
    .featured-works dl {
      grid-template-columns: 1fr; /* スマホでは縦1列に戻す */
      row-gap: 30px;
    }
    .featured-works dt {
      margin-bottom: 10px;
    }
    .featured-works dd {
      padding-bottom: 40px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1); /* 見やすくするための区切り線 */
    }
    .featured-works dd:last-child {
      border-bottom: none;
    }
    .featured-works img {
      width: 100%;
      height: auto;
    }
  }
</style>